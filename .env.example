KATO_ADAPTER=mock
KATO_AUTH_ENABLED=false
KATO_AUTH_PASSWORD=changeme
UPTIMEROBOT_API_KEY=
UPTIMEROBOT_POLL_INTERVAL=30000
PORT=3000
HOST=0.0.0.0

# ============================================================================
# RÉGLAGES CLIENT PAR DÉFAUT (Transmis par le BFF)
# ============================================================================
# Langue par défaut : 'fr' ou 'en' (défaut : fr)
KATO_DEFAULT_LOCALE=fr
# Thème par défaut : 'dark', 'light', 'amoled' ou 'auto' (défaut : dark)
KATO_DEFAULT_THEME=dark
# Format horaire par défaut : '24h' ou '12h' (défaut : 24h)
KATO_DEFAULT_TIME_FORMAT=24h
# Fuseau horaire par défaut : 'local', 'UTC', 'Europe/Paris', etc. (défaut : local)
KATO_DEFAULT_TIME_ZONE=local
# Affichage des secondes par défaut : 'true' ou 'false' (défaut : true)
KATO_DEFAULT_SHOW_SECONDS=true
# Alertes sonores par défaut : 'true' ou 'false' (défaut : false)
KATO_DEFAULT_SOUND_ENABLED=false
# Vitesse de défilement des incidents : 'slow', 'normal' ou 'fast' (défaut : slow)
KATO_DEFAULT_MARQUEE_SPEED=slow
# Mode de tri par défaut : 'smart', 'alpha' ou 'group' (défaut : smart)
KATO_DEFAULT_SORT_MODE=smart
