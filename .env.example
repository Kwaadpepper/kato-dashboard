# ============================================================================
# MONITORING ADAPTER CONFIGURATION
# ============================================================================
# Kato supports running multiple adapters concurrently (even multiple instances of
# the same provider, such as two separate Uptime Kuma servers).
#
# ----------------------------------------------------------------------------
# MODE 1: SIMPLE / HISTORICAL MODE (Single or comma-separated list)
# ----------------------------------------------------------------------------
# Values: 'mock', 'uptimerobot', 'uptimekuma', or combination e.g. 'uptimerobot,uptimekuma'
KATO_ADAPTER=mock
KATO_MOCK_COUNT=50

# ----------------------------------------------------------------------------
# MODE 2: NAMED MULTI-INSTANCES MODE (Recommended for multiple servers/accounts)
# ----------------------------------------------------------------------------
# Declare the active instance aliases separated by commas:
# KATO_ADAPTERS=kuma_prod,kuma_lan,robot_main

# --- Instance 1: kuma_prod (Uptime Kuma Production) ---
# ADAPTER_KUMA_PROD_TYPE=uptimekuma
# ADAPTER_KUMA_PROD_URL=https://kuma.example.com
# ADAPTER_KUMA_PROD_API_KEY=your_kuma_api_key_here
# ADAPTER_KUMA_PROD_POLL_INTERVAL=30000

# --- Instance 2: kuma_lan (Uptime Kuma Internal / Lab) ---
# ADAPTER_KUMA_LAN_TYPE=uptimekuma
# ADAPTER_KUMA_LAN_URL=http://192.168.1.50:3001
# ADAPTER_KUMA_LAN_API_KEY=
# ADAPTER_KUMA_LAN_POLL_INTERVAL=10000

# --- Instance 3: robot_main (Uptime Robot Primary Account) ---
# ADAPTER_ROBOT_MAIN_TYPE=uptimerobot
# ADAPTER_ROBOT_MAIN_API_KEY=your_uptimerobot_api_key_here
# ADAPTER_ROBOT_MAIN_POLL_INTERVAL=60000

# --- Instance 4: demo_staging (Mock environment) ---
# ADAPTER_DEMO_STAGING_TYPE=mock
# ADAPTER_DEMO_STAGING_COUNT=25
# ADAPTER_DEMO_STAGING_POLL_INTERVAL=5000

# ============================================================================
# CREDENTIALS FOR SIMPLE MODE (Used when KATO_ADAPTER is set)
# ============================================================================

# --- UPTIME ROBOT ADAPTER ---
UPTIMEROBOT_API_KEY=
UPTIMEROBOT_POLL_INTERVAL=30000

# --- UPTIME KUMA ADAPTER ---
# Base URL of your UptimeKuma instance (required when KATO_ADAPTER=uptimekuma)
UPTIME_KUMA_URL=https://kuma.example.com
# API key (Bearer token) — required once you have created an API key in UptimeKuma,
# as doing so permanently disables basic auth on the /metrics endpoint
UPTIME_KUMA_API_KEY=
# Polling interval in ms (default: 60000 — matches UptimeKuma's default check interval)
UPTIME_KUMA_POLL_INTERVAL=60000

# ============================================================================
# SECURITY & AUTHENTICATION
# ============================================================================
KATO_AUTH_ENABLED=false
KATO_AUTH_PASSWORD=changeme

# ============================================================================
# NETWORK & SERVER BINDING
# ============================================================================
PORT=3000
HOST=0.0.0.0

# ============================================================================
# CLIENT DEFAULT SETTINGS (Served via BFF)
# ============================================================================
# Default UI language: 'en' or 'fr' (default: en)
KATO_DEFAULT_LOCALE=en
# Default color theme: 'dark', 'light', 'amoled', or 'auto' (default: dark)
KATO_DEFAULT_THEME=dark
# Default clock format: '24h' or '12h' (default: 24h)
KATO_DEFAULT_TIME_FORMAT=24h
# Default timezone: 'local', 'UTC', 'America/New_York', 'Europe/Paris', etc. (default: local)
KATO_DEFAULT_TIME_ZONE=local
# Show seconds in clock by default: 'true' or 'false' (default: true)
KATO_DEFAULT_SHOW_SECONDS=true
# Enable audio alerts by default: 'true' or 'false' (default: false)
KATO_DEFAULT_SOUND_ENABLED=false
# Incident marquee scrolling speed: 'slow', 'normal', or 'fast' (default: slow)
KATO_DEFAULT_MARQUEE_SPEED=slow
# Default probe sorting mode: 'smart', 'alpha', or 'group' (default: smart)
KATO_DEFAULT_SORT_MODE=smart
