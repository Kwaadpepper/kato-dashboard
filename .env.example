# Active monitoring adapter: 'mock' or 'uptimerobot'
KATO_ADAPTER=mock
KATO_MOCK_COUNT=50
KATO_AUTH_ENABLED=false
KATO_AUTH_PASSWORD=changeme
UPTIMEROBOT_API_KEY=
UPTIMEROBOT_POLL_INTERVAL=30000
PORT=3000
HOST=0.0.0.0

# ============================================================================
# CLIENT DEFAULT SETTINGS (Served via BFF)
# ============================================================================
# Default UI language: 'en' or 'fr' (default: en)
KATO_DEFAULT_LOCALE=en
# Default color theme: 'dark', 'light', 'amoled', or 'auto' (default: dark)
KATO_DEFAULT_THEME=dark
# Default clock format: '24h' or '12h' (default: 24h)
KATO_DEFAULT_TIME_FORMAT=24h
# Default timezone: 'local', 'UTC', 'America/New_York', 'Europe/Paris', etc. (default: local)
KATO_DEFAULT_TIME_ZONE=local
# Show seconds in clock by default: 'true' or 'false' (default: true)
KATO_DEFAULT_SHOW_SECONDS=true
# Enable audio alerts by default: 'true' or 'false' (default: false)
KATO_DEFAULT_SOUND_ENABLED=false
# Incident marquee scrolling speed: 'slow', 'normal', or 'fast' (default: slow)
KATO_DEFAULT_MARQUEE_SPEED=slow
# Default probe sorting mode: 'smart', 'alpha', or 'group' (default: smart)
KATO_DEFAULT_SORT_MODE=smart
