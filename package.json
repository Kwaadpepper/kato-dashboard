{
	"name": "kato-dashboard",
	"private": true,
	"version": "1.1.0",
	"description": "High-density wallboard monitoring dashboard for desktop and TV screens with zero scroll",
	"license": "MIT",
	"type": "module",
	"keywords": [
		"monitoring",
		"dashboard",
		"wallboard",
		"svelte",
		"sveltekit",
		"high-density",
		"realtime",
		"sse",
		"uptime"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "node --test 'src/**/*.test.ts'",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.6.2",
		"eslint": "^10.11.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"dotenv": "^18.0.1",
		"lucide-svelte": "^1.0.1",
		"marked": "^18.0.13"
	}
}
